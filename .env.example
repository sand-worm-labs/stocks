# Where the main Sandworm app (apps/web) runs. Sign-in happens there.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:8081

# The marketing site that hosts the Terms and Privacy Policy.
NEXT_PUBLIC_LANDING_URL=http://localhost:8080

# Where the Documentation link in the header goes.
NEXT_PUBLIC_DOCS_URL=https://github.com/sand-worm-labs/sandworm-web

# Signs the sign-in nonce and the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Dynamic handles sign-in and wallets. Get the environment ID from the Dynamic dashboard (Developer, SDK & API Keys),
# switch on Base and Base Sepolia under Chains & Networks, and add this app's address under Security, Allowed Origins.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Set to true to send people to sign in with a wallet before they can open their portfolios
AUTH_REQUIRED=false

# A free CoinGecko "Demo" key (coingecko.com/en/api). Optional locally; needed on a deployed app, where the shared feed refuses (429).
COINGECKO_API_KEY=

# Where the main Sandworm app (apps/web) runs. Sign-in happens there.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:8081

# The marketing site that hosts the Terms and Privacy Policy.
NEXT_PUBLIC_LANDING_URL=http://localhost:8080

# The blog post that explains Sandworm Stocks in plain English. The welcome's "Learn more" opens it. Without it, it opens the blog.
NEXT_PUBLIC_LEARN_MORE_URL=

# Signs the sign-in nonce and the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Dynamic handles sign-in and wallets. Get the environment ID from the Dynamic dashboard (Developer, SDK & API Keys),
# switch on Base and Base Sepolia under Chains & Networks, and add this app's address under Security, Allowed Origins.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Signing in is required for every page. Set to false only to work on the app without a wallet (the tests do).
# AUTH_REQUIRED=true

# A free CoinGecko "Demo" key (coingecko.com/en/api). Optional locally; needed on a deployed app, where the shared feed refuses (429).
COINGECKO_API_KEY=

# Where strategies are kept: Stocks' own Postgres. Locally, `docker compose up -d db` and use the first line; deployed, Neon (neon.com) or any Postgres.
# The tables are made (and kept up to date) by `pnpm db:migrate`, which `pnpm dev` and `pnpm start` run first. The schema is src/db/schema.ts.
# Without it strategies are kept in .data/strategies.json, which is fine for trying the app and is lost on Vercel.
# DATABASE_URL=postgresql://stocks:stocks@localhost:5433/stocks
DATABASE_URL=

# The live market (prices and trades) and the chat on each token's Community tab are served by one small websocket server (pnpm realtime,
# port 3002 unless REALTIME_PORT is set), because the app's own host can't keep websockets open. While developing the app finds it on this
# machine; for a deployed app, set REALTIME_WS_URL to where it runs, as wss://... It needs the same AUTH_SECRET, which is how it knows who
# is signed in to chat.
REALTIME_WS_URL=
REALTIME_PORT=

# The main Sandworm app's API, with its /api prefix. Connecting a wallet makes the person's Sandworm account there, and their id is its id.
# Leave it out to work without the main app (accounts then use Dynamic's own id).
SANDWORM_API_URL=

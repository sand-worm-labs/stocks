pragma solidity ^0.8.20;

import {Script, console} from "forge-std/Script.sol";

import {Op} from "../src/blocks/types/Enums.sol";
import {About, Applies, OffChainFunction} from "../src/rules/offchain/OffChainRule.sol";
import {OffChainFunctions} from "../src/rules/offchain/OffChainFunctions.sol";

/// @notice Prints docs/offchain-rules.md from the contract's own texts, so the doc cannot drift from the hashes the chain holds:
/// `forge script script/PrintOffChainFunctions.s.sol -q >` (see the script for the exact post-processing)
contract PrintOffChainFunctions is Script {
    function run() external pure {
        console.log("#BEGIN");
        console.log("# Off-chain rules");
        console.log("");
        console.log(
            "Generated by `script/PrintOffChainFunctions.s.sol`. Do not edit by hand: the text of each function is in `src/rules/offchain/OffChainFunctions.sol`, and its hash is what a vault commits to."
        );
        console.log("");
        console.log(
            "A rule's **function hash** is `keccak256` of its spec text, exactly as written below. The app must compute this function and nothing else; anyone can recompute a result from the spec and compare it with what the app posted. The result goes to the signal board at the **channel** shown, and the rule's module reads it back and holds it against the vault's limit."
        );
        console.log("");
        OffChainFunction[] memory list = OffChainFunctions.all();
        for (uint256 i = 0; i < list.length; i++) {
            print(i + 1, list[i]);
        }
        console.log("#END");
    }

    function print(uint256 number, OffChainFunction memory f) private pure {
        bytes32 functionHash = keccak256(bytes(f.spec));
        console.log(string.concat("## ", vm_uint(number), ". ", f.name));
        console.log("");
        console.log(string.concat("- **Function hash:** `", toHex(functionHash), "`"));
        console.log(
            string.concat(
                "- **Judges:** ",
                appliesText(f.applies),
                ". **Result is about:** ",
                aboutText(f.about),
                ". **Holds when:** result ",
                opText(f.op),
                " the vault's limit."
            )
        );
        console.log(string.concat("- **Channel:** ", channelText(f.about), "."));
        console.log("");
        console.log(string.concat("> ", f.spec));
        console.log("");
    }

    function channelText(About about) private pure returns (string memory) {
        if (about == About.Market) return "`functionHash`";
        if (about == About.Stock) return "`keccak256(abi.encode(functionHash, stockToken))`";
        if (about == About.Account) return "`keccak256(abi.encode(functionHash, vault))`";
        return "`keccak256(abi.encode(functionHash, vault, stockToken))`";
    }

    function appliesText(Applies a) private pure returns (string memory) {
        if (a == Applies.Buys) return "each buy";
        if (a == Applies.Sells) return "each sell";
        return "the portfolio after every rebalance";
    }

    function aboutText(About a) private pure returns (string memory) {
        if (a == About.Market) return "the whole market";
        if (a == About.Stock) return "one stock, for every vault";
        if (a == About.Account) return "one vault";
        return "one stock in one vault";
    }

    function opText(Op op) private pure returns (string memory) {
        if (op == Op.LessOrEqual) return "<=";
        if (op == Op.GreaterOrEqual) return ">=";
        if (op == Op.Less) return "<";
        if (op == Op.Greater) return ">";
        if (op == Op.Equal) return "==";
        return "!=";
    }

    function vm_uint(uint256 n) private pure returns (string memory) {
        return n == 10 ? "10" : string(abi.encodePacked(bytes1(uint8(48 + n))));
    }

    function toHex(bytes32 value) private pure returns (string memory) {
        bytes memory alphabet = "0123456789abcdef";
        bytes memory out = new bytes(66);
        out[0] = "0";
        out[1] = "x";
        for (uint256 i = 0; i < 32; i++) {
            out[2 + i * 2] = alphabet[uint8(value[i]) >> 4];
            out[3 + i * 2] = alphabet[uint8(value[i]) & 0x0f];
        }
        return string(out);
    }
}

# Where the main Sandworm app (apps/web) runs. Sign-in happens there.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:8081

# The marketing site that hosts the Terms and Privacy Policy.
NEXT_PUBLIC_LANDING_URL=http://localhost:8080

# Where the Documentation link in the header goes.
NEXT_PUBLIC_DOCS_URL=https://github.com/sand-worm-labs/sandworm-web

# The blog post that explains Sandworm Stocks in plain English. The welcome's "Learn more" opens it. Without it, it opens the blog.
NEXT_PUBLIC_LEARN_MORE_URL=

# Signs the sign-in nonce and the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Dynamic handles sign-in and wallets. Get the environment ID from the Dynamic dashboard (Developer, SDK & API Keys),
# switch on Base and Base Sepolia under Chains & Networks, and add this app's address under Security, Allowed Origins.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Signing in is required for every page. Set to false only to work on the app without a wallet (the tests do).
# AUTH_REQUIRED=true

# A free CoinGecko "Demo" key (coingecko.com/en/api). Optional locally; needed on a deployed app, where the shared feed refuses (429).
COINGECKO_API_KEY=

# Where strategies are kept. Any Postgres, such as Neon (neon.com), or the main app's. The table is made on first use (src/lib/store/schema.ts).
# Without it strategies are kept in .data/strategies.json, which is fine for trying the app and is lost on Vercel.
DATABASE_URL=

# The chat on each token's Community tab runs as its own small server (pnpm chat, port 3002 unless CHAT_PORT is set), because the app's
# own host can't keep websockets open. While developing the app finds it on this machine; for a deployed app, set CHAT_WS_URL to where it
# runs, as wss://... Both need the same AUTH_SECRET, which is how the chat server knows who is signed in.
CHAT_WS_URL=
CHAT_PORT=

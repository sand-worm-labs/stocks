# Copy to .env (never committed). Testnet only: use a throwaway key that holds no real funds.

# Where the prices are read (Base mainnet) and where they are written (Base Sepolia).
MAINNET_RPC_URL=https://base-rpc.publicnode.com
TESTNET_RPC_URL=https://sepolia.base.org

# The MirrorBook contract on Base Sepolia (apps/contracts/src/testnet/MirrorBook.sol). The key below must be the account that deployed it.
MIRROR_ADDRESS=
RELAYER_PRIVATE_KEY=

# How often to look, how far a pool's tick must move before it is written again (1 tick is 0.01%), and how long a pool may go without a write.
POLL_SECONDS=2
MIN_TICK_MOVE=1
# How far a pool's depth may move, in percent, before it is written again: depth decides how far a trade moves the price in the copy.
MIN_LIQUIDITY_MOVE_PERCENT=10
MAX_AGE_SECONDS=3600
BATCH_SIZE=100

# true reads the pools and prints what would be written, and sends nothing.
DRY_RUN=true
POOLS_FILE=pools.json

# true asks the Stocks API for the stocks and their pools and mirrors those, instead of reading POOLS_FILE. The key is the one the API and the web app share.
DISCOVER_POOLS=false
STOCKS_API_URL=
STOCKS_API_KEY=

# true also makes the mainnet's swaps again in the copies, as a market maker (see README). Needs MIRROR_ROUTER_ADDRESS below, and a MAINNET_RPC_URL that serves eth_getLogs.
REPLAY_SWAPS=false
MIRROR_ROUTER_ADDRESS=

# pnpm provision (see README): the test-network copies of the pools. Deployed by apps/contracts script/DeployMirrorMarket.s.sol, with the key above.
FAUCET_ADDRESS=
TEST_USDC_ADDRESS=
POOL_FACTORY_ADDRESS=
# Optional: salts from apps/contracts/tools/mine-vanity.sh, { "tNVDAc": "0x..." }, so a stock lands at an address like its mainnet twin's
SALTS_FILE=vanity-salts.json
MARKET_FILE=testnet-market.json

# pnpm scan-pools (see README): finds each stock's pools on the chain. MAINNET_RPC_URL must serve old blocks and eth_getLogs over 50,000 blocks (an archive node).
# STOCKS_FILE=deployments/base-mainnet/stocks.json
# SCAN_ALL=false
# SCAN_FROM_BLOCK=

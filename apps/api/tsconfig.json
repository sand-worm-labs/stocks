{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/common/*": [
        "src/common/*"
      ],
      "@/core/*": [
        "src/core/*"
      ],
      "@/features/*": [
        "src/features/*"
      ],
      "@/infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@/config/*": [
        "src/config/*"
      ],
      "@/_mockdata/*": [
        "src/_mockdata/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true
  }
}
